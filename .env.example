# Shared
NODE_ENV=development
APP_NAME="LEEL Ride"
APP_TAGLINE="Your ride, your control."

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
NEXT_PUBLIC_PHOTON_URL=https://photon.komoot.io
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
NEXT_PUBLIC_GEOCODE_COUNTRY_CODES=ng
NEXT_PUBLIC_RADIO_BROWSER_URL=https://de1.api.radio-browser.info

# API
API_PORT=4000
WEB_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leel_ride
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PRICING_SIGNING_SECRET=replace-with-a-long-random-pricing-secret
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

# External services - configure when ready
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-long-random-google-oauth-state-secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_DATA_API_KEY=
SMS_PROVIDER_API_KEY=
